EXPO_PUBLIC_API_URL=https://quiz-erudit-backend.turbosuslik.online/api/v1
# Default slug for the main dev tunnel (quiz-erudit-dev.turbosuslik.online, port 8090).
# The Coat of Arms dev server (port 8091, quiz-erudit-coa.turbosuslik.online) overrides
# this by exporting EXPO_PUBLIC_APP_SLUG=coat-of-arms on its own start command.
EXPO_PUBLIC_APP_SLUG=coat-of-arms

# Sentry crash/error reporting. Leave empty to keep Sentry disabled.
# Get the DSN from Sentry → Project Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=https://e5d07305de29c35df8e95f1cfd1bcd28@o4511615038455808.ingest.us.sentry.io/4511615097438208
# Set to 1 to also report from local dev builds (off by default).
# Temporarily ON so the "Send Sentry test error" button works in dev. Set back to empty after verifying.
EXPO_PUBLIC_SENTRY_DEBUG=1

# RevenueCat (Google Play billing) public Android SDK key. Safe to commit.
# Falls back to the same literal in code, so builds work without EAS secrets.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_hFgRbNrOlUHcMtKClkwWcYIBLvd
