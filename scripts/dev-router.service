[Unit]
# Expo Go dev-tunnel router (Variant B-free+). Routes *-dev.turbosuslik.online
# (delivered by the single cloudflared wildcard ingress rule) to each app's fixed
# Metro port from /var/www/quiz-erudit/dev-servers.json. Runs as the eugen user;
# no root at runtime. Install once:
#   sudo cp scripts/dev-router.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dev-router
After=network.target
Description=Expo Go dev-tunnel router (*-dev.turbosuslik.online -> Metro ports)

[Service]
Type=simple
User=eugen
WorkingDirectory=/var/www/quiz-erudit
ExecStart=/usr/local/bin/node /var/www/quiz-erudit/scripts/dev-router.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
